{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "aceternity-svelte",
	"compatibility_date": "2026-11-01",
	"workers_dev": false,
	"routes": [{ "pattern": "aceternity.sveltekit.io", "custom_domain": true }],
	"assets": {
		"directory": "build",
		"not_found_handling": "404-page"
	}
}
